# ==============================================================================
# GLOBAL CONNECTION SETTINGS
# Used by all scripts to connect to infrastructure.
# ==============================================================================
TIMESCALE_DSN=postgresql://postgres:postgres@localhost:5432/sensors
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# ==============================================================================
# SCRIPT: src/per-message-insert.py
# Compares Naive (Per-Message) vs Batched Ingestion.
# Also used by: src/publisher.py, src/naive_ingest.py
# ==============================================================================
# Number of simulated devices
NUM_DEVICES=5000
# Publishing rate per device (Hz)
# Total Load = NUM_DEVICES * PUBLISH_RATE_HZ
PUBLISH_RATE_HZ=1
# Flush interval for batched ingestion (seconds)
FLUSH_INTERVAL_SEC=5.0
# Log progress every N messages (for naive ingestion to reduce console spam)
NAIVE_LOG_INTERVAL=1000
# Duration of the comparison test (seconds)
DEMO_TEST_DURATION_SEC=15

# ==============================================================================
# EXPERIMENT 1: src/experiments/back-pressure-overload.py
# Demonstrates single consumer failure under high load.
# ==============================================================================
EXPERIMENT_PHASE_1_DEVICES=1000
EXPERIMENT_PHASE_2_DEVICES=5000
# The breaking point: 30000 devices * 1 Hz = 30k msg/s
EXPERIMENT_PHASE_3_DEVICES=30000
EXPERIMENT_RATE_HZ=1
EXPERIMENT_BATCH_COUNT=5
EXPERIMENT_TIMEOUT_SEC=60
EXPERIMENT_FLUSH_INTERVAL_SEC=5.0
# MQTT QoS for the OVERLOAD publisher (0 or 1)
#   0 = fire-and-forget (max throughput, stresses the DB not the broker)
#   1 = at-least-once   (realistic IIoT, ~16k msg/s cap per connection)
EXPERIMENT_OVERLOAD_QOS=1

# ==============================================================================
# EXPERIMENT 2: src/experiments/back-pressure-scaling.py
# Demonstrates horizontal scaling with topic-based partitioning.
# Uses EXPERIMENT_PHASE_3_DEVICES as the target load.
# ==============================================================================
EXPERIMENT_PUBLISHER_BATCH_SIZE=100
# MQTT QoS for the SCALING publishers (0 or 1)
#   0 = fire-and-forget (max throughput, stresses the DB not the broker)
#   1 = at-least-once   (realistic IIoT, ~16k msg/s cap per connection)
EXPERIMENT_SCALING_QOS=1
# Number of consumer processes (each gets its own partition + publisher)
EXPERIMENT_CONSUMER_COUNT=3

# ==============================================================================
# SCRIPT: src/experiments/graceful-shutdown.py
# verifies no data loss on shutdown.
# ==============================================================================
EXPERIMENT_PUBLISH_RATE=5000
EXPERIMENT_TEST_DURATION=10

# ==============================================================================
# SCRIPT: src/experiments/duplicate-handling.py
# Verifies idempotency of insertions.
# ==============================================================================
EXPERIMENT_UNIQUE_MESSAGES=1000
EXPERIMENT_DUPLICATE_MESSAGES=500

# ==============================================================================
# SCRIPT: src/experiments/error-recovery.py
# Verifies partial batch failure recovery (poison pill).
# ==============================================================================
EXPERIMENT_VALID_MESSAGES_BATCH=100
EXPERIMENT_POISON_PILL_MESSAGE='{"ts": "2025-01-01T00:00:00Z", "device_id": "bad-sensor", "metric": "temperature", "value": "check-engine-light"}'

# ==============================================================================
# UTILITY: src/validate.py
# Automated validation suite (wraps logic from above scripts).
# ==============================================================================
# Set to 1 to skip "Press Enter" prompt for automated testing
SKIP_INPUT=0
